{
  "info": {
    "name": "citas-api",
    "description": "Pruebas de las secciones 5.1 y 5.2 de la guía SENATI (páginas 35–36 y 43–44). Ejecutar la colección completa en orden: main, rama 1 y rama 2. Los registros creados para las pruebas se eliminan al finalizar. Para Codespaces cambia baseUrl por la dirección del puerto 8080, sin barra final, y perfilEsperado a demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "perfilEsperado",
      "value": "dev",
      "type": "string"
    },
    {
      "key": "tituloPrueba",
      "value": "",
      "type": "string"
    },
    {
      "key": "servicioCreadoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "terapistaCreadaId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "main",
      "item": [
        {
          "name": "Inicio y perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"API y perfil\", function () { const datos = pm.response.json(); pm.expect(datos.proyecto).to.eql(\"citas-api\"); pm.expect(datos.estado).to.eql(\"OK\"); pm.expect(datos.perfil).to.eql(pm.variables.get(\"perfilEsperado\")); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "rama 1 · login y servicios",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.requestName.startsWith(\"01\")) {",
              "    pm.collectionVariables.set(\"tituloPrueba\", \"Reflexología prueba \" + Date.now());",
              "    pm.collectionVariables.unset(\"servicioCreadoId\");",
              "}"
            ]
          }
        }
      ],
