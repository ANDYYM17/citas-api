            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gerente@terapias.pe\",\n  \"password\": \"Clave123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Datos de sesión y rol\", function () { const datos = pm.response.json(); pm.expect(datos.rol).to.eql(\"GERENTE\"); pm.expect(datos.email).to.eql(\"gerente@terapias.pe\"); pm.expect(datos).to.have.all.keys(\"usuarioId\", \"email\", \"rol\"); });"
                ]
